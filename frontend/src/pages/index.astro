---
const researchTopics = [
	'population',
	'movement',
	'health',
	'traffic',
	'waste',
	'vaccination',
	'identification',
	'planning',
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="WATFA is a community-sourced open dataset of street dogs and cats in Guwahati."
		/>
		<meta name="theme-color" content="#f3efe5" />
		<meta property="og:title" content="WATFA — Where are the free agents?" />
		<meta property="og:description" content="A public record of Guwahati's street dogs and cats." />
		<meta property="og:type" content="website" />
		<title>WATFA — Where are the free agents?</title>
	</head>
	<body>
		<a class="skip-link" href="#overview">Skip to overview</a>

		<div class="site">
			<header>
				<a class="brand" href="#top" aria-label="WATFA, back to top">
					<svg viewBox="0 0 42 42" aria-hidden="true">
						<circle cx="12" cy="11" r="4"></circle>
						<circle cx="21" cy="7" r="4"></circle>
						<circle cx="30" cy="11" r="4"></circle>
						<path d="M11 27c0-7 4-12 10-12s10 5 10 12c0 5-4 8-10 8s-10-3-10-8Z"></path>
					</svg>
					<strong>WATFA</strong>
				</a>
			</header>

			<main id="top">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-copy">
						<div class="hero-wordmark">
							<strong>WATFA</strong>
							<span aria-hidden="true">/</span>
							<p>Where are the<br />free agents?</p>
						</div>
						<h1 id="hero-title">
							A community-sourced public dataset of street dogs and cats, creating a shared, ongoing
							record of the free agents who live across our neighbourhoods.
						</h1>
					</div>

					<aside class="hero-how" aria-labelledby="how-title">
						<div class="card-head">
							<h2 id="how-title"><span class="card-number" aria-hidden="true">01 /</span> How it works</h2>
							<span class="card-icon" aria-hidden="true">↘</span>
						</div>
						<div class="process-loop">
							<ol>
								<li>
									<div class="process-step-head"><span>01</span><strong>Record</strong></div>
									<p class="process-summary">
										If you spot a stray while out in your neighbourhood, you can record the sighting with a <strong>photo</strong>, the <strong>time</strong> and <strong>approximate location</strong>, plus
										any useful notes about their health, behaviour etc.
									</p>
									<div class="process-detail">
										<h3>Bootstrapping records</h3>
										<p>
Voluteers coordinate recurring recording sessions(weekly) in their neighbourhoods across the city, helping build the initial data for each area
and follow change over time.</p>
									</div>
								</li>
								<li>
									<div class="process-step-head"><span>02</span><strong>Index</strong></div>
									<p class="process-summary">
										Each sighting strengthens a shared index that people can search to learn whether an animal has been seen before, connect sightings over time and find possible matches for lost pets.
									</p>
									<div class="process-detail">
										<h3>Gets better with every sighting</h3>
										<p>
											WATFA organises photos, markings, locations and notes into searchable evidence. As more sightings are recorded, the index builds a richer picture of each animal and makes future search and matching more useful.
										</p>
									</div>
								</li>
							</ol>
							<div class="loop-return" aria-hidden="true"></div>
							<div class="loop-forward" aria-hidden="true"></div>
						</div>
					</aside>
				</section>

				<section class="poster-grid" id="overview" aria-label="More ways WATFA can help">
					<article class="card card-lost" aria-labelledby="lost-title">
						<div class="card-head">
							<h2 id="lost-title"><span class="card-number" aria-hidden="true">02 /</span> Lost &amp; Found</h2>
							<span class="card-icon" aria-hidden="true">•••</span>
						</div>
						<p>
							A missing report in Chandmari and a casual sighting on Zoo Road may be the same animal.
							WATFA can flag the possible match and preserve a timeline beyond one poster or post.
						</p>
						<figure class="match-ascii">
							<pre aria-hidden="true"><span>[ MISSING ]</span> o----o----o <span>[ SIGHTING ]</span>
  CHANDMARI             ZOO ROAD</pre>
							<figcaption>A missing report in Chandmari connected to a possible sighting on Zoo Road.</figcaption>
						</figure>
					</article>

					<article class="card card-search" aria-labelledby="search-title">
						<div class="card-head">
							<h2 id="search-title"><span class="card-number" aria-hidden="true">03 /</span> WATFA Search Party</h2>
							<span class="card-icon" aria-hidden="true">▦</span>
						</div>
						<p>
							Build the people, playbooks and tools a neighbourhood needs to act quickly—spread the
							word, coordinate streets, document sightings and make every search smarter than the last.
						</p>
						<ul class="tags">
							<li>Local network</li><li>Search playbooks</li><li>Coordination tools</li><li>Better next time</li>
						</ul>
					</article>

					<article class="card card-research" aria-labelledby="research-title">
						<div class="card-head">
							<h2 id="research-title"><span class="card-number" aria-hidden="true">04 /</span> Research and analysis</h2>
							<span class="card-icon" aria-hidden="true">◎</span>
						</div>
						<p>
							Long-running observations can help communities, researchers, civic bodies and welfare
							groups understand:
						</p>
						<ul class="topic-list">
							{researchTopics.map((topic) => <li>{topic}</li>)}
						</ul>
						<div class="research-notes">
							<div class="research-note research-caution">
								<strong>Read with care.</strong>
								<span>Community observations have sampling bias. Record survey effort, missing data and confidence levels. Obscure sensitive locations. This is useful evidence, not an official count.</span>
							</div>
						</div>
						<div class="ring" aria-hidden="true"></div>
					</article>

					<article class="card card-faq" aria-labelledby="faq-title">
						<div class="card-head">
							<h2 id="faq-title"><span class="card-number" aria-hidden="true">05 /</span> FAQ</h2>
							<span class="card-icon" aria-hidden="true">?</span>
						</div>
						<dl class="faq-list">
							<div>
								<dt>Is this an app?</dt>
								<dd>
									No. WATFA is a community-sourced open public dataset—not an app, platform, startup
									or product. It may use forms, bots, a website or an app as its interface, but those
									can change. What matters is the shared dataset and the process for maintaining it.
								</dd>
							</div>
							<div>
								<dt>What about animal privacy?</dt>
								<dd>
									Precise locations help research and identification, but can also help thieves,
									smugglers or people trying to harm or illegally relocate animals. Public locations
									should stay <strong>deliberately fuzzy</strong> and evolve as we learn what works.
								</dd>
							</div>
							<div>
								<dt>Can WATFA help with animal rescue?</dt>
								<dd>
									Rescue is not WATFA's primary focus. If an animal is injured or in distress, use a
									dedicated service such as <a href="https://karunanidhan.app/">Karuna Nidhan</a>.
									We would rather integrate with existing rescue networks than replace or interfere
									with them.
								</dd>
							</div>
						</dl>
					</article>

					<article class="card card-help" id="help" aria-labelledby="help-title">
						<div class="card-head">
							<h2 id="help-title"><span class="card-number" aria-hidden="true">06 /</span> How to help</h2>
							<span class="card-icon" aria-hidden="true">☰</span>
						</div>
						<dl>
							<div><dt>Donate</dt><dd>Infrastructure, experiments and fieldwork.</dd></div>
							<div><dt>Develop</dt><dd>Collection, matching, mapping and search tools. Our one developer wants friends.</dd></div>
							<div><dt>Volunteer</dt><dd>Survey, photograph, contribute and spread the word.</dd></div>
						</dl>
					</article>
				</section>
			</main>

			<footer>
				<strong>WATFA</strong>
				<p>Community-sourced · Open public dataset · Guwahati</p>
				<a href="#top">Back to top ↑</a>
			</footer>
		</div>
	</body>
</html>

<style>
	:root {
		--ink: #101010;
		--paper: #f3efe5;
		--blue: #174fe9;
		--orange: #ff3d18;
		--lime: #b7ef00;
		--pink: #ed4aa8;
		--yellow: #ffbd16;
		--purple: #291257;
		--line: 1px solid var(--ink);
		--sans: "Helvetica Neue", Helvetica, Arial, sans-serif;
		--mono: "SFMono-Regular", Consolas, monospace;
	}

	* { box-sizing: border-box; }

	html {
		scroll-behavior: smooth;
		background: var(--ink);
	}

	body {
		margin: 0;
		background: var(--ink);
		color: var(--ink);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	a { color: inherit; }
	p, h1, h2, ol, ul, dl, dd { margin-top: 0; }
	::selection { background: var(--pink); }

	.skip-link {
		position: fixed;
		top: 8px;
		left: 8px;
		z-index: 100;
		padding: 8px 12px;
		background: white;
		font: 700 0.7rem var(--mono);
		transform: translateY(-150%);
	}

	.skip-link:focus { transform: translateY(0); }

	.site {
		width: min(100% - 32px, 1440px);
		margin: 16px auto;
		background: var(--paper);
		border: var(--line);
	}

	header {
		display: flex;
		height: 62px;
		align-items: center;
		justify-content: flex-start;
		border-bottom: var(--line);
	}

	header .brand {
		height: 100%;
		margin: 0;
		padding: 0 18px;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 1.25rem;
		letter-spacing: -0.05em;
		text-decoration: none;
	}

	.brand svg {
		width: 34px;
		height: 34px;
		padding: 6px;
		background: var(--orange);
		border-radius: 50%;
		fill: var(--ink);
	}

	footer a {
		font: 700 0.62rem var(--mono);
		text-transform: uppercase;
		text-underline-offset: 4px;
	}

	.hero {
		display: grid;
		height: auto;
		min-height: max(560px, calc(65svh - 80px));
		grid-template-columns: 1.22fr 0.78fr;
		border-bottom: var(--line);
	}

	.hero-copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(24px, 3.5vw, 52px);
		border-right: var(--line);
	}

	.card-head {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 16px;
		align-items: start;
		margin-bottom: clamp(14px, 1.6vw, 22px);
	}

	.card-head h2 {
		min-width: 0;
		margin: 0;
		font-size: clamp(1.5rem, 2vw, 2.5rem);
		font-weight: 900;
		letter-spacing: -0.065em;
		line-height: 0.95;
		text-transform: uppercase;
	}

	.card-number {
		font-family: var(--mono);
		letter-spacing: -0.08em;
		white-space: nowrap;
	}

	.card-icon {
		margin-top: 0.2em;
		font: 700 1rem/1 var(--sans);
	}

	.hero-wordmark {
		display: flex;
		align-items: center;
		gap: clamp(10px, 1.4vw, 20px);
		text-transform: uppercase;
	}

	.hero-wordmark strong {
		font-size: clamp(2.8rem, 5.8vw, 5rem);
		font-weight: 900;
		letter-spacing: -0.09em;
		line-height: 0.8;
	}

	.hero-wordmark > span {
		color: var(--orange);
		font-size: clamp(2rem, 3.5vw, 3.5rem);
		font-weight: 300;
		line-height: 1;
	}

	.hero-wordmark p {
		margin: 0;
		font: 800 clamp(0.62rem, 0.9vw, 0.82rem)/1.08 var(--mono);
		letter-spacing: -0.04em;
	}

	.hero h1 {
		margin: auto 0;
		max-width: 760px;
		font-size: clamp(1.8rem, 3vw, 3.1rem);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1.02;
	}

	.hero-how {
		display: flex;
		min-width: 0;
		flex-direction: column;
		padding: clamp(20px, 2.4vw, 34px);
		background: var(--blue);
		color: white;
	}

	.process-loop {
		position: relative;
	}

	.hero-how ol {
		display: grid;
		grid-template-rows: repeat(2, 1fr);
		gap: 8px;
		margin: 0 25px;
		padding: 0;
		list-style: none;
	}

	.hero-how li {
		display: flex;
		min-height: 0;
		flex-direction: column;
		padding: clamp(9px, 1.3vw, 15px);
		border: 1px solid white;
	}

	.process-step-head {
		display: grid;
		grid-template-columns: 30px 1fr;
		gap: 10px;
		align-items: baseline;
	}

	.process-step-head span {
		font: 700 0.68rem var(--mono);
		color: var(--lime);
	}

	.process-step-head strong {
		font-size: clamp(1rem, 1.2vw, 1.15rem);
		text-transform: uppercase;
	}

	.process-summary {
		max-width: 66ch;
		margin: 8px 0 13px 40px;
		font-size: clamp(0.78rem, 0.92vw, 0.88rem);
		line-height: 1.38;
	}

	.process-summary strong {
		padding: 0.08em 0.3em;
		background: var(--lime);
		color: var(--ink);
		font-weight: 800;
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	.process-detail {
		margin-top: auto;
		padding: 11px 0 0 40px;
		border-top: 1px solid rgb(255 255 255 / 55%);
	}

	.process-detail h3 {
		margin: 0 0 5px;
		color: var(--lime);
		font: 800 clamp(0.7rem, 0.82vw, 0.78rem)/1.25 var(--mono);
		text-transform: uppercase;
	}

	.process-detail p {
		max-width: 68ch;
		margin: 0;
		font: 500 clamp(0.68rem, 0.78vw, 0.76rem)/1.42 var(--mono);
	}

	.loop-return,
	.loop-forward {
		position: absolute;
		top: 25%;
		bottom: 25%;
		width: 26px;
	}

	.loop-return {
		left: 0;
		border-top: 2px solid var(--lime);
		border-bottom: 2px solid var(--lime);
		border-left: 2px solid var(--lime);
	}

	.loop-return::before {
		position: absolute;
		top: -5px;
		right: -1px;
		width: 0;
		height: 0;
		border-top: 4px solid transparent;
		border-bottom: 4px solid transparent;
		border-left: 7px solid var(--lime);
		content: "";
	}

	.loop-forward {
		right: 0;
		border-top: 2px solid var(--lime);
		border-right: 2px solid var(--lime);
		border-bottom: 2px solid var(--lime);
	}

	.loop-forward::after {
		position: absolute;
		bottom: -5px;
		left: -1px;
		width: 0;
		height: 0;
		border-top: 4px solid transparent;
		border-right: 7px solid var(--lime);
		border-bottom: 4px solid transparent;
		content: "";
	}

	.poster-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		scroll-margin-top: 10px;
	}

	.card {
		--card-pad: clamp(20px, 2.5vw, 36px);
		position: relative;
		min-width: 0;
		min-height: 320px;
		padding: var(--card-pad);
		border-right: var(--line);
		border-bottom: var(--line);
		overflow: hidden;
	}

	.card:nth-child(2n) { border-right: 0; }

	.card p,
	.card li,
	.card dd {
		position: relative;
		z-index: 2;
		font-size: clamp(0.67rem, 0.8vw, 0.78rem);
		line-height: 1.38;
	}

	.card p { margin-bottom: 8px; }
	.card strong { font-weight: 800; }

	.card-lost {
		display: flex;
		min-height: 390px;
		flex-direction: column;
		background: var(--orange);
	}

	.card-lost > p {
		max-width: 64ch;
		font-size: clamp(0.78rem, 1vw, 0.92rem);
		line-height: 1.45;
	}

	.match-ascii {
		margin: auto 0 0;
		padding-top: clamp(24px, 4vw, 54px);
		overflow: hidden;
	}

	.match-ascii pre {
		margin: 0;
		padding: clamp(13px, 1.5vw, 20px) 0;
		border-top: var(--line);
		border-bottom: var(--line);
		font: 800 clamp(0.55rem, 0.85vw, 0.76rem)/1.9 var(--mono);
		letter-spacing: -0.055em;
		white-space: pre;
	}

	.match-ascii pre span:last-child { color: var(--blue); }

	.match-ascii figcaption {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.card-search { background: var(--paper); }

	.tags,
	.topic-list {
		position: relative;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		margin: 10px 0 0;
		padding: 0;
		list-style: none;
	}

	.tags li,
	.topic-list li {
		padding: 3px 6px;
		border: var(--line);
		font: 700 0.5rem var(--mono);
		text-transform: uppercase;
	}

	.card-research {
		display: flex;
		min-height: 370px;
		flex-direction: column;
		background: var(--blue);
		color: white;
	}

	.topic-list { max-width: 68%; }
	.topic-list li { border-color: white; }

	.research-notes {
		position: relative;
		z-index: 3;
		margin: auto calc(-1 * var(--card-pad)) calc(-1 * var(--card-pad));
		padding-top: 20px;
	}

	.research-note {
		display: grid;
		grid-template-columns: minmax(92px, auto) 1fr;
		gap: 12px;
		align-items: start;
		padding: 11px var(--card-pad);
		border-top: 1px solid white;
		color: var(--ink);
	}

	.research-caution { background: var(--lime); }

	.research-note strong {
		font-size: 0.74rem;
		text-transform: uppercase;
	}

	.research-note span {
		font-size: clamp(0.58rem, 0.7vw, 0.68rem);
		line-height: 1.3;
	}

	.research-note b { font-weight: 800; }

	.ring {
		position: absolute;
		right: -8%;
		bottom: -18%;
		width: 44%;
		aspect-ratio: 1;
		border: 17px solid var(--lime);
		border-radius: 50%;
	}

	.card-faq {
		display: flex;
		min-height: 370px;
		flex-direction: column;
		background: var(--yellow);
	}

	.faq-list {
		position: relative;
		z-index: 2;
		margin: auto 0 0;
	}

	.faq-list > div {
		padding-top: clamp(14px, 2vw, 24px);
		border-top: var(--line);
	}

	.faq-list dt {
		max-width: 18ch;
		margin-bottom: 12px;
		font-size: clamp(1.2rem, 2vw, 1.9rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.faq-list dd {
		max-width: 62ch;
		margin: 0;
	}

	.card-help {
		display: flex;
		min-height: 230px;
		grid-column: 1 / -1;
		flex-direction: column;
		border-right: 0;
		border-bottom: 0;
		scroll-margin-top: 10px;
	}

	.card-help dl {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: auto 0 0;
	}

	.card-help dl > div {
		display: grid;
		grid-template-columns: 74px 1fr;
		gap: 10px;
		padding: 12px clamp(12px, 1.5vw, 22px);
		border-top: var(--line);
		border-right: var(--line);
	}

	.card-help dl > div:first-child { padding-left: 0; }
	.card-help dl > div:last-child { padding-right: 0; border-right: 0; }

	.card-help dt {
		font-size: clamp(0.68rem, 0.8vw, 0.8rem);
		font-weight: 800;
		text-transform: uppercase;
	}

	.card-help dd { margin: 0; }

	footer {
		display: grid;
		height: 62px;
		grid-template-columns: auto 1fr auto;
		gap: 20px;
		align-items: center;
		padding: 0 18px;
		background: var(--ink);
		color: white;
	}

	footer strong { color: var(--orange); }
	footer p { margin: 0; font: 600 0.56rem var(--mono); text-transform: uppercase; }

	@media (max-width: 900px) {
		.site { width: calc(100% - 20px); margin: 10px; }

		.hero {
			height: auto;
			min-height: 0;
			grid-template-columns: 1fr;
		}

		.hero-copy { min-height: 500px; border-right: 0; border-bottom: var(--line); }
		.hero-how { min-height: 0; }
		.poster-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.card { min-height: 260px; border-right: var(--line); border-bottom: var(--line); }
		.card:nth-child(2n) { border-right: 0; }
		.card p, .card li, .card dd { font-size: 0.75rem; }
		.topic-list { max-width: 78%; }
		.card-help { min-height: 220px; border-right: 0; border-bottom: 0; }
