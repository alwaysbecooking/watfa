---
const pathname = Astro.url.pathname;
---

<header class="site-header">
	<a class="brand" href="/" aria-label="WATFA, home">
		<img src="/logo.png" alt="" width="480" height="480" />
		<strong>WATFA</strong>
	</a>

	<nav aria-label="Main navigation">
		<a href="/dataset" aria-current={pathname === '/dataset' ? 'page' : undefined}>Explore dataset</a>
		<a href="/lost" aria-current={pathname === '/lost' ? 'page' : undefined}>Mark lost</a>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		height: 62px;
		align-items: stretch;
		justify-content: space-between;
		border-bottom: 1px solid var(--ink, #1c211e);
	}

	.brand {
		margin: 0;
		padding: 0 18px;
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 1.25rem;
		text-decoration: none;
	}

	.brand strong {
		font-family: var(--sans, "Helvetica Neue", Helvetica, Arial, sans-serif);
		font-weight: 900;
		letter-spacing: -0.09em;
		line-height: 0.8;
	}

	.brand img {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	nav {
		display: flex;
		align-items: stretch;
	}

	nav a {
		display: flex;
		align-items: center;
		padding: 0 clamp(12px, 2vw, 28px);
		border-left: 1px solid var(--ink, #1c211e);
		font: 700 0.68rem var(--mono, "SFMono-Regular", Consolas, monospace);
		letter-spacing: 0.02em;
		text-decoration: none;
		text-transform: uppercase;
	}

	nav a:hover,
	nav a:focus-visible,
	nav a[aria-current="page"] {
		background: var(--ink, #1c211e);
		color: var(--paper, #f2efe7);
	}

	@media (max-width: 560px) {
		.site-header { height: 58px; }
		.brand { padding: 0 12px; }
		.brand strong { display: none; }
		nav a {
			padding: 0 10px;
			font-size: 0.58rem;
		}
	}
</style>
